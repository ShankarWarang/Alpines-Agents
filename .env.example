# -------------------------------------------------
# zkVerify Agent Games - Environment Configuration
# -------------------------------------------------

# Shared - Agent Games Platform
AGENT_GAMES_HMAC_SECRET=your-32-byte-hex-secret-from-agent-games-dashboard
ZKVERIFY_API_URL=https://kurier.zkverify.io
ZKVERIFY_API_KEY=your-zkverify-api-key

# Alpines Keeper (Proof Gatekeeper)
KEEPER_PORT=3001
KEEPER_CIRCUIT_WASM=./circuits/gatekeeper.wasm
KEEPER_CIRCUIT_ZKEY=./circuits/gatekeeper_final.zkey
KEEPER_VK_HASH=your-registered-verification-key-hash

# Alpines Stealer (Steal the VFY)
STEALER_PORT=3002
STEALER_CIRCUIT_WASM=./circuits/steal.wasm
STEALER_CIRCUIT_ZKEY=./circuits/steal_final.zkey
STEALER_VK_HASH=your-registered-stealer-verification-key-hash

# Rapidsnark (native C++ prover - 5-10x faster than snarkjs)
RAPIDSNARK_BIN=/usr/local/bin/rapidsnark

# Logging
LOG_LEVEL=info
NODE_ENV=production
